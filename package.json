{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "dev:local": "node scripts/start-local.mjs",
    "dev:supabase": "node scripts/start-supabase.mjs",
    "db:compare-dump": "node scripts/compare-supabase-dump.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:dispatch": "node --test scripts/dispatch-critical.test.mjs",
    "test:partner-orders": "node --test scripts/partner-order-lifecycle.test.mjs",
    "test:api-security": "pnpm --filter @workspace/api-server run build && node scripts/api-security-regression.mjs",
    "test:sessions": "DB_MIGRATIONS_DIR=../lib/db/migrations pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/session-regression.ts",
    "test:operations-worker": "DB_MIGRATIONS_DIR=../lib/db/migrations pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/operations-worker-regression.ts",
    "test:auth-onboarding": "DB_MIGRATIONS_DIR=../lib/db/migrations pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/auth-onboarding-regression.ts",
    "test:payment-wallet-admin": "DB_MIGRATIONS_DIR=../lib/db/migrations pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/payment-wallet-admin-regression.ts",
    "test:static-surfaces": "pnpm --filter @workspace/tasweqet-ui run test:static-surfaces",
    "test:critical": "pnpm run test:api-security && pnpm run test:sessions && pnpm run test:auth-onboarding && pnpm run test:operations-worker && pnpm run test:payment-wallet-admin && pnpm run test:dispatch && pnpm run test:partner-orders && pnpm run test:static-surfaces",
    "validate:storage": "pnpm --filter @workspace/scripts exec tsx object-storage-smoke.mts",
    "validate:authevo": "node scripts/authevo-readiness.mjs",
    "validate:paymob": "node scripts/paymob-readiness.mjs",
    "validate:deployment": "node scripts/deployment-smoke.mjs",
    "test": "pnpm run test:critical"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.62.3",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
